{
  "id": "life",
  "version": "1.0.0",
  "workspace": "LifePal",
  "display_name": "个人生活知识档案",
  "course_patterns": [],
  "node_types": ["entity", "concept", "method", "case", "metric", "process", "event", "decision", "rule", "material"],
  "relation_kinds": ["pre", "related", "part_of", "supports", "example_of", "causes", "contrasts", "bridge"],
  "required_fields": ["name", "kp_type", "gist", "source_refs"],
  "quality_rules": [
    "个人记录、经验判断和外部建议必须明确区分，并保留来源与时间",
    "个人计划与实际发生的事件分别记录，不把意向当作事实",
    "生活经验应保留适用条件，不能替代专业判断或推广为普遍结论",
    "模型提出的知识与关系必须经过审核，不能自动视为已确认事实"
  ],
  "extraction_sections": ["摘要", "记录与背景", "经验与判断", "适用边界", "溯源", "相关链接"],
  "wiki_rules": {
    "frontmatter_schema": "cyberpal.note.v2",
    "link_style": "wikilink",
    "evidence_locator": "page_or_markdown_line"
  }
}
