{
  "name": "mindock-desktop",
  "version": "0.6.4",
  "private": true,
  "description": "MinDock personal knowledge assistant for Windows",
  "author": "MinDock",
  "license": "SEE LICENSE IN LICENSE",
  "main": "main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "resedit": "1.7.2"
  },
  "build": {
    "appId": "local.mindock.desktop.windows",
    "productName": "MinDock",
    "copyright": "MinDock",
    "asar": true,
    "afterPack": "./after-pack.cjs",
    "directories": {"output": "../../output/windows/installer", "buildResources": "../../output/windows/build-resources"},
    "electronDist": "../../output/windows/downloads/electron-v44.7.0-win32-x64.zip",
    "files": ["main.cjs", "runtime.cjs", "policy.cjs", "package.json"],
    "extraResources": [{"from": "../../output/windows/staging/backend", "to": "backend"}],
    "win": {"target": ["nsis"], "icon": "../../output/windows/build-resources/MinDock.ico", "signAndEditExecutable": false},
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "useZip": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MinDock",
      "artifactName": "MinDock-${version}-Windows-x64-Setup.${ext}",
      "installerLanguages": ["en_US", "zh_CN"],
      "displayLanguageSelector": false
    }
  }
}
